---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const labs = (await getCollection('labs')).sort((a, b) => a.data.order - b.data.order);
  return labs.map((lab, i) => ({
    params: { slug: lab.id },
    props: { lab, prev: labs[i - 1], next: labs[i + 1] },
  }));
}

interface Props {
  lab: CollectionEntry<'labs'>;
  prev?: CollectionEntry<'labs'>;
  next?: CollectionEntry<'labs'>;
}

const { lab, prev, next } = Astro.props;
const { Content, headings } = await render(lab);
const toc = headings.filter((h) => h.depth === 2);
const facts = [
  ['Course', lab.data.course],
  ['Type', lab.data.type],
  ['Tools', lab.data.tools],
  ['Skills', lab.data.skills],
].filter(([, v]) => v);
---

<Base title={lab.data.title} description={lab.data.summary}>
  <article class="section">
    <div class="container">
      <a class="back" href="/learning">← All activities</a>
      <header class="head">
        <span class="tag">{lab.data.category}</span>
        <h1>{lab.data.title}</h1>
        <p class="summary">{lab.data.summary}</p>
        {
          facts.length > 0 && (
            <dl class="facts">
              {facts.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </header>

      <div class="layout">
        {
          toc.length >= 5 && (
            <nav class="toc" aria-label="On this page">
              <p>On this page</p>
              <ul>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        <div class="prose">
          <Content />
        </div>
      </div>

      <nav class="pager">
        {prev ? <a class="card" href={`/learning/${prev.id}`}><span>← Previous</span><strong>{prev.data.title}</strong></a> : <span></span>}
        {next && <a class="card right" href={`/learning/${next.id}`}><span>Next →</span><strong>{next.data.title}</strong></a>}
      </nav>
    </div>
  </article>
</Base>

<style>
  .back {
    display: inline-block;
    margin-bottom: 24px;
    font-weight: 500;
  }
  .head {
    max-width: 760px;
    margin-bottom: 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--border);
  }
  h1 {
    font-size: clamp(1.9rem, 4.5vw, 2.5rem);
    font-weight: 800;
    margin: 12px 0 8px;
  }
  .summary {
    font-size: 1.1rem;
    color: var(--text-muted);
    margin: 0 0 20px;
  }
  .facts {
    display: grid;
    gap: 8px;
    margin: 0 0 24px;
    font-size: 0.93rem;
  }
  .facts div {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 12px;
  }
  .facts dt {
    font-weight: 600;
    color: var(--text-muted);
  }
  .facts dd {
    margin: 0;
  }
  .layout {
    display: flex;
    gap: 48px;
    align-items: flex-start;
  }
  .toc {
    flex: none;
    width: 220px;
    position: sticky;
    top: 88px;
    font-size: 0.88rem;
    order: 2;
  }
  .toc p {
    font-weight: 600;
    margin: 0 0 8px;
  }
  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid var(--border);
  }
  .toc a {
    display: block;
    padding: 4px 0 4px 12px;
    color: var(--text-muted);
  }
  .toc a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .prose {
    flex: 1;
    min-width: 0;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 56px;
  }
  .pager a {
    padding: 18px 22px;
    display: flex;
    flex-direction: column;
    color: var(--text);
  }
  .pager a:hover {
    text-decoration: none;
    border-color: var(--accent);
    color: var(--text);
  }
  .pager span {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .pager .right {
    text-align: right;
  }
  @media (max-width: 900px) {
    .toc {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .right {
      text-align: left;
    }
    .facts div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
