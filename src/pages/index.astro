---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LabCard from '../components/LabCard.astro';
import Icon from '../components/Icon.astro';
import TechTag from '../components/TechTag.astro';
import { site, skills, certifications } from '../data/site';
import { projects } from '../data/projects';

const featured = [
  'phishing-incident-triage',
  'syn-flood-attack-analysis',
  'security-audit-botium-toys',
  'linux-file-permissions',
  'sql-login-filtering',
  'python-allow-list-updater',
];
const labs = (await getCollection('labs')).filter((l) => featured.includes(l.id));
labs.sort((a, b) => featured.indexOf(a.id) - featured.indexOf(b.id));
const labCount = (await getCollection('labs')).filter((l) => l.data.category !== 'Study notes').length;
const handle = site.github ? site.github.split('/').pop() : site.name.toLowerCase();
const stackLines = [['React', 'Node.js'], ['MongoDB', 'PHP', 'SQL']];
---

<Base>
  <section class="hero" id="about">
    <div class="container hero-inner">
      <div>
        <p class="status"><span class="dot" aria-hidden="true"></span>open to internships</p>
        <p class="prompt" aria-hidden="true"><span class="user">{handle}@{site.location.toLowerCase()}</span>:<span class="tilde">~</span>$ whoami</p>
        <h1>Hi, I'm <span class="accent">{site.name}</span>.</h1>
        <p class="role">{site.role}{site.university && ` · ${site.university}`}</p>
        <p class="lead">{site.tagline}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="#projects"><Icon name="code" />View projects</a>
          {site.cv && <a class="btn" href={site.cv} target="_blank" rel="noopener"><Icon name="download" />Download CV</a>}
          {site.github && <a class="btn" href={site.github} target="_blank" rel="noopener"><Icon name="github" />GitHub ↗</a>}
        </div>
        <ul class="hero-facts">
          <li><Icon name="monitor" /><strong>{projects.length}</strong> full-stack systems</li>
          <li><Icon name="shield" /><strong>{labCount}</strong> security portfolio activities</li>
          <li><Icon name="award" /><strong>{certifications.length}</strong> professional certificate{certifications.length === 1 ? '' : 's'}</li>
        </ul>
      </div>

      <figure class="term" aria-label="My profile, written as code">
        <div class="term-bar" aria-hidden="true">
          <i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i>
          <span>profile.js</span>
        </div>
        <pre><span class="k">const</span> {site.name.toLowerCase()} = {'{'}
  role: <span class="s">'Computing student'</span>,
  uni: <span class="s">'{site.university}'</span>,
  stack: [{stackLines.map((line, li) => (
    <Fragment>{li > 0 && '\n          '}{line.map((t, i) => <Fragment><span class="s">'{t}'</span>{i < line.length - 1 ? ', ' : li < stackLines.length - 1 ? ',' : ''}</Fragment>)}</Fragment>
  ))}],
  learning: <span class="s">'Cybersecurity'</span>,
  certs: <span class="n">{certifications.length}</span>,
  lookingFor: <span class="s">'Internship'</span>,
{'}'};

<span class="c">// $ node profile.js</span>
<span class="ok">✔</span> ready to contribute</pre>
      </figure>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">// projects</span>
        <h2>Things I've built</h2>
        <p>Two complete web systems, each with separate roles for users and admins, a real database and attention to security.</p>
      </div>
      <div class="grid grid-2">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <section class="section section-alt" id="learning">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">// certifications &amp; learning</span>
        <h2>What I'm learning</h2>
        <p>Outside my degree I'm learning cybersecurity. These are write-ups of the portfolio activities I completed, with the scenario, my answers and what I learned.</p>
      </div>

      {certifications.map((c) => (
        <div class="card cert">
          {c.badge
            ? <img class="cert-img" src={c.badge} alt={`${c.name} badge`} width="120" height="120" loading="lazy" />
            : <div class="icon-tile cert-badge"><Icon name="award" size={26} /></div>}
          <div>
            <h3>{c.name}</h3>
            <p class="cert-issuer">{c.issuer}{c.date && ` · Issued ${c.date}`}</p>
            <p class="cert-detail">{c.detail}</p>
            {c.url && <a class="cert-link" href={c.url} target="_blank" rel="noopener">Verify on Coursera ↗</a>}
          </div>
        </div>
      ))}

      <div class="grid grid-3 labs">
        {labs.map((lab) => <LabCard lab={lab} />)}
      </div>
      <div class="more-row">
        <a class="btn" href="/learning">See all {labCount} activities and my study notes →</a>
      </div>
    </div>
  </section>

  <section class="section" id="skills">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">// skills</span>
        <h2>Tools and technologies</h2>
      </div>
      <div class="grid grid-3">
        {skills.map((s) => (
          <div class="card skill">
            <div class="skill-head">
              <span class="icon-tile"><Icon name={s.icon} /></span>
              <h3>{s.group.toLowerCase().replace(/ /g, '_')}</h3>
            </div>
            <ul class="tags">
              {s.items.map((i) => <TechTag name={i} />)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt" id="contact">
    <div class="container contact">
      <span class="eyebrow">// contact</span>
      <h2>Let's talk</h2>
      <p>I'm looking for an internship. If you have a role that fits, or a question about my work, I'd love to hear from you.</p>
      <div class="btn-row center">
        {site.email && <a class="btn btn-primary" href={`mailto:${site.email}`}><Icon name="mail" />Email me</a>}
        {site.linkedin && <a class="btn" href={site.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" />LinkedIn ↗</a>}
        {site.github && <a class="btn" href={site.github} target="_blank" rel="noopener"><Icon name="github" />GitHub ↗</a>}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    padding: 88px 0 72px;
    background:
      radial-gradient(ellipse 60% 80% at 85% 0%, color-mix(in srgb, var(--accent) 12%, transparent), transparent),
      linear-gradient(var(--border) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, var(--border) 1px, transparent 1px) 0 0 / 32px 32px,
      var(--bg);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, var(--bg));
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 18px;
    padding: 4px 12px;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--green) 25%, transparent);
  }
  .prompt {
    margin: 0 0 12px;
    font-family: var(--mono);
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .prompt .user {
    color: var(--green);
  }
  .prompt .tilde {
    color: var(--accent);
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.4rem);
    font-weight: 800;
    margin-bottom: 8px;
  }
  .hero h1 .accent {
    color: var(--accent);
  }
  .role {
    margin: 0 0 16px;
    font-family: var(--mono);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .lead {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--text-muted);
    max-width: 560px;
    margin: 0 0 28px;
  }
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    list-style: none;
    padding: 26px 0 0;
    margin: 36px 0 0;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
  }
  .hero-facts li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .hero-facts :global(.icon) {
    color: var(--accent);
  }
  .hero-facts strong {
    font-family: var(--mono);
    color: var(--text);
    font-size: 1.3rem;
  }
  .term {
    margin: 0;
    overflow: hidden;
    font-family: var(--mono);
    font-size: 0.85rem;
    color: #d6deeb;
    background: #0f1623;
    border: 1px solid #1f2a3d;
    border-radius: var(--radius);
    box-shadow: 0 20px 50px rgb(15 22 35 / 0.25);
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 14px;
    background: #161f30;
    border-bottom: 1px solid #1f2a3d;
  }
  .term-bar i {
    display: block;
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }
  .term-bar span {
    margin-left: 10px;
    font-size: 0.75rem;
    color: #7d8aa3;
  }
  .term pre {
    margin: 0;
    padding: 18px 20px;
    line-height: 1.7;
    white-space: pre-wrap;
  }
  .term .k {
    color: #82aaff;
  }
  .term .s {
    color: #c3e88d;
  }
  .term .n {
    color: #f78c6c;
  }
  .term .c {
    color: #637394;
  }
  .term .ok {
    color: #4ade80;
  }
  .cert {
    display: flex;
    gap: 18px;
    padding: 22px 24px;
    margin-bottom: 24px;
  }
  .cert h3 {
    font-size: 1.15rem;
    margin: 0;
  }
  .cert p {
    margin: 0;
  }
  .cert-issuer {
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .cert-detail {
    margin-top: 8px !important;
  }
  .cert-badge {
    width: 48px;
    height: 48px;
    border-radius: 12px;
  }
  .cert-img {
    flex-shrink: 0;
    width: 120px;
    height: 120px;
    object-fit: contain;
  }
  .cert-link {
    display: inline-block;
    margin-top: 10px;
  }
  .more-row {
    margin-top: 24px;
  }
  .skill {
    padding: 20px 22px;
  }
  .skill-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .skill-head .icon-tile {
    width: 34px;
    height: 34px;
  }
  .skill h3 {
    font-size: 0.95rem;
    margin: 0;
  }
  .contact {
    text-align: center;
    max-width: 640px;
  }
  .contact h2 {
    font-size: clamp(1.6rem, 3vw, 2rem);
  }
  .contact p {
    color: var(--text-muted);
    margin: 0 0 24px;
  }
  .center {
    justify-content: center;
  }
  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding: 56px 0 48px;
    }
    .cert {
      flex-direction: column;
    }
  }
</style>
